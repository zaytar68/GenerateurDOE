@using GenerateurDOE.Models
@inject Radzen.NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<button class="btn btn-outline-primary btn-sm @CssClass"
        @onclick="() => TelechargerDocument(Document)"
        disabled="@isLoading"
        title="@Tooltip">
    @if (isLoading)
    {
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
    }
    else
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public DocumentGenere Document { get; set; } = null!;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "Télécharger";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isLoading = false;

    private async Task TelechargerDocument(DocumentGenere document)
    {
        if (isLoading) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            NotificationService.Notify(Radzen.NotificationSeverity.Info, "Génération", "Génération du document en cours...");

            // Construction de l'URL de l'API de téléchargement
            var downloadUrl = $"/api/DocumentDownload/{document.Id}";

            // Ouverture dans un nouvel onglet pour déclencher le téléchargement
            // Évite les limitations de sérialisation JSON pour les gros fichiers
            await JSRuntime.InvokeVoidAsync("open", downloadUrl, "_blank");

            // Notification de succès après un court délai pour laisser le temps à la génération
            await Task.Delay(1500);
            NotificationService.Notify(Radzen.NotificationSeverity.Success, "Téléchargement",
                "Le téléchargement devrait démarrer dans quelques instants...");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Error, "Erreur",
                $"Erreur lors du lancement du téléchargement: {ex.Message}");
            Console.WriteLine($"[ERROR] DocumentDownloadButton: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}